generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// One row per client company. Company-specific behavior lives in `config`, never in code.
model Company {
  id                    String                   @id @default(cuid())
  slug                  String                   @unique
  name                  String
  /// Validated by `companyConfigSchema` (src/companies/company-config.ts).
  config                Json
  /// The company's own words for the assistant. The prompt puts them after the platform rules.
  instructions          String                   @default("") @db.Text
  /// AES-256-GCM ciphertext of the company's API keys. See src/lib/crypto.ts.
  encryptedSecrets      String?
  whatsappPhoneNumberId String?                  @unique
  /// Set while archived: its operators cannot use the panel and the bot does not answer its number.
  archivedAt            DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  operators             Operator[]
  knowledgeFiles        KnowledgeFile[]
  threads               Thread[]
  messages              Message[]
  llmUsages             LlmUsage[]
  adminAuditEntries     AdminAuditEntry[]
  settingsVersions      CompanySettingsVersion[]
  leadStageChanges      LeadStageChange[]
}

/// Maps a backoffice login to the one company it belongs to.
model Operator {
  id                  String            @id @default(cuid())
  companyId           String
  email               String            @unique
  supabaseUserId      String?           @unique
  /// Set while archived: this login cannot use the panel.
  archivedAt          DateTime?
  /// Last time Supabase accepted an invitation (or password-reset) email for this operator.
  invitedAt           DateTime?
  /// Why the last invitation failed, in Spanish. Cleared when one succeeds.
  inviteError         String?
  createdAt           DateTime          @default(now())
  company             Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploads             KnowledgeFile[]
  assignedThreads     Thread[]          @relation("ThreadAssignee")
  contactedThreads    Thread[]          @relation("ThreadContactedBy")
  stageChangedThreads Thread[]          @relation("ThreadStageChangedBy")
  stageChanges        LeadStageChange[]

  @@index([companyId])
}

/// Text extracted from a file an operator uploaded. Only the text is kept, not the original file.
model KnowledgeFile {
  id           String    @id @default(cuid())
  companyId    String
  name         String
  /// Lower-cased name. Uploading a file with the same name replaces this row.
  nameKey      String
  format       String
  mimeType     String
  sizeBytes    Int
  sha256       String
  text         String    @db.Text
  charCount    Int
  uploadedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy   Operator? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([companyId, nameKey])
}

enum ThreadState {
  greeting
  qualify
  answer
  handoff
  closed
}

/// Where the lead is for the sales team. Forward-only: the bot moves Calificando to Por contactar
/// (or Sin interés), and only a person moves Por contactar to Contactado.
enum LeadStage {
  qualifying
  to_contact
  contacted
  not_interested
}

enum ThreadSource {
  whatsapp
  form
}

/// Why a CRM write is owed. The text written is built from the thread at write time, so a newer
/// request simply replaces an older one in the outbox.
enum CrmAction {
  handoff
  close
  needs_human
  /// The lead's first message (or form), or a bot turn that changed what HubSpot shows.
  update
}

model Thread {
  id                  String            @id @default(cuid())
  companyId           String
  /// E.164, e.g. +59899123456. Matches form contacts and WhatsApp contacts.
  phone               String
  /// WhatsApp id (digits) used as the `to` of outbound messages.
  waId                String
  /// WhatsApp profile name, when Meta sends it.
  name                String?
  /// Only from a form payload. The assistant does not ask for email.
  email               String?
  source              ThreadSource      @default(whatsapp)
  /// The engine's conversation step (what the prompt asks next, and when HubSpot is written).
  state               ThreadState       @default(greeting)
  stage               LeadStage         @default(qualifying)
  /// When the thread reached Por contactar: the lead message that completed the required items.
  handedOffAt         DateTime?
  /// The operator (advisor) who has the lead. Any operator of the company can take or reassign it.
  assignedToId        String?
  assignedAt          DateTime?
  contactedAt         DateTime?
  contactedById       String?
  /// Who marked it contacted, kept when that operator is deleted or when it was a platform admin.
  contactedByEmail    String?
  /// The last stage change, by a person or by the assistant. The turn writes its stage only if
  /// this is still what it read, so a person's change during a turn wins.
  stageChangedAt      DateTime?
  stageChangedById    String?
  /// Null when the assistant moved the stage. Kept when that operator is deleted.
  stageChangedByEmail String?
  paused              Boolean           @default(false)
  pausedAt            DateTime?
  needsHuman          Boolean           @default(false)
  needsHumanReason    String?
  /// What the lead told the assistant, keyed by the company's `config.collect[].key`. Values are text.
  collected           Json              @default("{}")
  /// Short bullets from the model, rewritten every turn: the conversation and what the lead wants.
  summary             String?           @db.Text
  callTime            String?
  /// Start of WhatsApp's 24-hour free-form reply window.
  lastInboundAt       DateTime?
  lastMessageAt       DateTime?
  lastMessagePreview  String?
  /// Lease that keeps two processes from answering the same thread at once.
  processingUntil     DateTime?
  crmContactId        String?
  /// Set when a CRM write is owed; cleared once it succeeds. Failed writes are retried.
  crmPendingAction    CrmAction?
  /// Bumped on every request, so a write that finishes after a newer request does not clear it.
  crmRequestVersion   Int               @default(0)
  /// Lease for CRM writes, apart from `processingUntil`: a slow HubSpot never holds up a reply.
  crmLeaseUntil       DateTime?
  crmAttempts         Int               @default(0)
  crmNextAttemptAt    DateTime?
  crmLastError        String?
  crmSyncedAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  company             Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedTo          Operator?         @relation("ThreadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  contactedBy         Operator?         @relation("ThreadContactedBy", fields: [contactedById], references: [id], onDelete: SetNull)
  stageChangedBy      Operator?         @relation("ThreadStageChangedBy", fields: [stageChangedById], references: [id], onDelete: SetNull)
  messages            Message[]
  stageChanges        LeadStageChange[]
  llmUsages           LlmUsage[]

  @@unique([companyId, phone])
  @@index([companyId, lastMessageAt])
  @@index([companyId, stage, handedOffAt])
  @@index([assignedToId])
  @@index([contactedById])
  @@index([stageChangedById])
  @@index([crmPendingAction])
}

/// A stage a person picked in the panel (any direction). The assistant's own moves are not here.
model LeadStageChange {
  id             String    @id @default(cuid())
  companyId      String
  threadId       String
  fromStage      LeadStage
  toStage        LeadStage
  /// Null through support access, or once that operator is deleted.
  changedById    String?
  changedByEmail String
  /// A platform admin made it from inside the company (also in AdminAuditEntry).
  support        Boolean   @default(false)
  createdAt      DateTime  @default(now())
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  thread         Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  changedBy      Operator? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
  @@index([companyId])
  @@index([changedById])
}

enum MessageDirection {
  inbound
  outbound
}

model Message {
  id          String           @id @default(cuid())
  companyId   String
  threadId    String
  direction   MessageDirection
  /// WhatsApp message type: text, template, image, audio, sticker, ...
  type        String
  body        String           @db.Text
  waMessageId String?          @unique
  /// Outbound delivery status from Meta: sent, delivered, read, failed.
  status      String?
  /// Inbound only: when the engine took this message into a turn.
  handledAt   DateTime?
  sentAt      DateTime         @default(now())
  createdAt   DateTime         @default(now())
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  thread      Thread           @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, sentAt])
  @@index([companyId])
  @@index([direction, handledAt])
}

model LlmUsage {
  id               String   @id @default(cuid())
  companyId        String
  threadId         String?
  model            String
  inputTokens      Int
  outputTokens     Int
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  latencyMs        Int
  createdAt        DateTime @default(now())
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  thread           Thread?  @relation(fields: [threadId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
}

enum SettingsKind {
  config
  instructions
  whatsappPhoneNumberId
}

/// One saved version of a company's config, instructions, or WhatsApp phone number id. The newest
/// of each kind matches the Company row; restoring an older one saves it again as a new version.
model CompanySettingsVersion {
  id                    String       @id @default(cuid())
  companyId             String
  kind                  SettingsKind
  /// Set when kind is config. Validated by `companyConfigSchema`.
  config                Json?
  /// Set when kind is instructions.
  instructions          String?      @db.Text
  /// When kind is whatsappPhoneNumberId: the value of `Company.whatsappPhoneNumberId`. Null means no number.
  whatsappPhoneNumberId String?
  /// Signed-in email of whoever saved it. Null for the version that existed before versioning.
  createdByEmail        String?
  /// Saved by a platform admin through support access.
  viaSupport            Boolean      @default(false)
  /// The version this one restored, when it was a restore.
  restoredFromId        String?
  createdAt             DateTime     @default(now())
  company               Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, kind, createdAt])
}

/// A write a platform admin made inside a company through support access (`X-Company-Id`), or to
/// a company from Empresas (archive, restore, delete, operators). Stored before the write runs, so
/// no admin write goes unrecorded. Survives the company's deletion.
model AdminAuditEntry {
  id          String   @id @default(cuid())
  /// Null once the company is deleted; `companySlug` still says which one it was.
  companyId   String?
  companySlug String
  adminEmail  String
  /// Method and path, e.g. "POST /internal/threads/<id>/pause". Request bodies are never stored.
  action      String
  /// HTTP status of the response. Null until it is sent, or if the browser left before it.
  status      Int?
  createdAt   DateTime @default(now())
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
}
