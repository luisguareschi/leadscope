# Local stand-in for Supabase Postgres. The hosted project, when created, goes in us-east-1.
# Do not commit a real .env. Copy this file to .env and replace every secret.
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Pooled connection for the running app. Direct connection for Prisma migrations.
# Locally both can point at the same Postgres from docker compose.
DATABASE_URL=postgresql://leadscope:leadscope@localhost:5432/leadscope
DIRECT_URL=postgresql://leadscope:leadscope@localhost:5432/leadscope

# 32 bytes, base64. Dev sample only — generate a new one for staging and production:
#   openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# fake: local panel login with Authorization: Bearer fake:<operator email>
# supabase: verify a Supabase Auth JWT (public signup stays off)
AUTH_MODE=fake
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Platform secrets. Per-company Anthropic, HubSpot, Meta, and Google tokens are encrypted on Company.
META_APP_SECRET=dev-meta-app-secret
META_WEBHOOK_VERIFY_TOKEN=dev-verify-token
# Optional shared Google service account JSON, one line. Leave empty to sync the fixture sheet.
GOOGLE_SERVICE_ACCOUNT_JSON=

BACKOFFICE_ORIGIN=http://localhost:3000
BURST_WAIT_MS=3000
SHEET_SYNC_INTERVAL_MS=21600000
SITE_NOTES_INTERVAL_MS=21600000

# Leave empty until a Sentry project exists. The process still logs structured errors.
SENTRY_DSN=
ANTHROPIC_MODEL=claude-haiku-4-5

# Seed an operator the fake login can use. Ignored when AUTH_MODE=supabase unless you set the user id.
SEED_OPERATOR_EMAIL=operador@example.com
SEED_OPERATOR_SUPABASE_USER_ID=fake-user
