# Copy to .env for local development. Never commit real values.

NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Runtime connection. On Supabase use the pooled URL (port 6543, ?pgbouncer=true).
DATABASE_URL=postgresql://leadscope:leadscope@localhost:5432/leadscope
# Migrations. On Supabase use the direct URL (port 5432).
DIRECT_URL=postgresql://leadscope:leadscope@localhost:5432/leadscope

# 32 random bytes, base64. Generate with: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=ZGV2LW9ubHktc2VjcmV0cy1rZXktMzItYnl0ZXMhISE=

# Meta app (shared by every company on this deployment).
META_APP_SECRET=dev-meta-app-secret
META_WEBHOOK_VERIFY_TOKEN=dev-verify-token
META_GRAPH_VERSION=v23.0

# Backoffice auth. `dev` signs in by email with no password and is refused when NODE_ENV=production.
AUTH_MODE=dev
SUPABASE_URL=
# Only for projects still on the legacy HS256 JWT secret. New projects verify through JWKS.
SUPABASE_JWT_SECRET=
# Only used by `npm run operator:add` to create the Supabase Auth user.
SUPABASE_SERVICE_ROLE_KEY=

BACKOFFICE_ORIGIN=http://localhost:3000

# When a company has no key for an integration, use the in-process fake instead of failing.
# Always off in production.
ALLOW_FAKE_INTEGRATIONS=true
# Development only: used when the company has no Anthropic key of its own.
ANTHROPIC_API_KEY=

# Wait this long after a lead's last message before replying, so a burst gets one answer.
REPLY_DEBOUNCE_MS=3500

SENTRY_DSN=
