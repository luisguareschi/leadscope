# Copy to .env.local for local development.

NEXT_PUBLIC_API_URL=http://localhost:3001

# "dev" signs in by operator email with no password (the backend must run with AUTH_MODE=dev).
# "supabase" uses Supabase Auth; set the two values below from the us-east-1 project.
NEXT_PUBLIC_AUTH_MODE=dev
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
