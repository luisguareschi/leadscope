# Express backend. The panel never talks to Postgres.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# fake: local login, Bearer fake:<email>. Do not use this on a deployed panel.
# supabase: email login against the us-east-1 project. Public signup stays off.
NEXT_PUBLIC_AUTH_MODE=fake
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
